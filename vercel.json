{
  "outputDirectory": "public",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/api/precos/status", "destination": "/api/precos/status.js" },
    { "source": "/api/precos", "destination": "/api/precos/index.js" },
    { "source": "/api/anp", "destination": "/api/anp.js" }
  ]
}
